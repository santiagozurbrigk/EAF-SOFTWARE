# ──────────────────────────────────────────────────
# EAF — Evergreen de Alta Frecuencia
# Variables de entorno — copiar a .env.local
# ──────────────────────────────────────────────────

# Supabase (https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# App URL (Vercel → Settings → Domains)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta Ads (Meta Business Manager → Apps → tu app)
# Se guarda encriptado en la tabla organizations por usuario
# No va en variables globales — se almacena por org en DB

# GoHighLevel
# Igual que Meta — se guarda por organización en DB

# Railway Worker (URL del worker de procesamiento de video)
RAILWAY_WORKER_URL=http://localhost:4000
RAILWAY_WORKER_SECRET=secret_compartido_entre_nextjs_y_worker

# Webhook secret de GHL (para validar firma de webhooks entrantes)
GHL_WEBHOOK_SECRET=tu_ghl_webhook_secret
